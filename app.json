{
  "expo": {
    "name": "Inkbound",
    "slug": "inkbound",
    "description": "A visual character creator and character sheet for 5e tabletop games.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inkbound",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16120F",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.inkbound.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EDE3CC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Inkbound",
      "shortName": "Inkbound",
      "themeColor": "#16120F",
      "backgroundColor": "#16120F"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16120F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c333a516-6a8f-4456-91c3-19a9e7692d62"
      }
    },
    "owner": "jonacard"
  }
}
